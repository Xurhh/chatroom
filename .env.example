# chatroom 环境变量样例：复制成 .env 或直接 export
# 生产对应 deploy/k8s/config.yaml 的 ConfigMap / Secret。

# ---- HTTP ----
ADDR=:8080
APP_ENV=dev                 # Redis key 前缀 chat:{env}:...，多套环境共用 Redis 不打架
LOG_LEVEL=info              # debug | info | warn | error

# ---- Redis（M1 起需要；M0 纯内存模式可以不启动 Redis）----
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- 认证 ----
JWT_SECRET=dev-only-secret-change-me   # 生产用 openssl rand -hex 32
JWT_TTL=24h

# ---- 跨域 / WS Origin 白名单（逗号分隔）----
ALLOWED_ORIGINS=http://localhost:5173

# ---- 默认房间（启动时确保存在，让 M0 开箱即用）----
DEFAULT_ROOM=lobby
DEFAULT_ROOM_NAME=大客厅

# ---- WS 调参（guide 1.5 / 2.3 / 2.7）----
WS_PONG_WAIT=60s             # 读超时；公网移动端可放宽到 90s-120s
WS_SEND_BUF=256              # 每连接下行队列容量
WS_SYNC_LIMIT=200            # join 时最多补拉条数
WS_RATE_PER_SEC=10           # 每连接消息速率上限
WS_RATE_BURST=20             # 令牌桶深度
WS_MAX_CONTENT_BYTES=4096    # 单条消息内容上限
MAX_CONNECTIONS=20000        # 超过后 Upgrade 前返回 503

# ---- 关停 / 调试 ----
DRAIN_DELAY=8s               # 摘流后等 LB 传播；K8s terminationGracePeriodSeconds 要大于它
PPROF_ADDR=127.0.0.1:6060    # 置空则关闭 pprof